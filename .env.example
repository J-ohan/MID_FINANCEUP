# Copia este archivo con el nombre ".env" (en esta misma carpeta).
# El archivo .env no se sube a git.
# Son las direcciones de los 5 CRUD. Si los corres en tu PC con los
# puertos de siempre, puedes dejarlas tal cual.
URL_CRUD_AUTH=http://localhost:8081/v1
URL_CRUD_FINANZAS=http://localhost:8082/v1
URL_CRUD_EDUCACION=http://localhost:8083/v1
URL_CRUD_NEGOCIO=http://localhost:8084/v1
URL_CRUD_SOPORTE=http://localhost:8085/v1

# ---------------------------------------------------------------
# Token de sesion (JWT): texto secreto de MINIMO 32 caracteres.
# Si no se pone, el MID usa uno temporal y las sesiones se pierden
# cada vez que se reinicia. Nunca lo compartas ni lo subas a git.
# ---------------------------------------------------------------
JWT_SECRETO=

# ---------------------------------------------------------------
# Correo para enviar los codigos (login y recuperar contrasena).
# Ejemplo con Gmail: activa la verificacion en 2 pasos y crea una
# "contrasena de aplicacion" (no es tu clave normal de Gmail).
# Usa el puerto 587. Si SMTP_HOST queda vacio, en modo dev el
# correo se muestra en la consola del MID (solo para pruebas).
# ---------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USUARIO=
SMTP_CLAVE=
CORREO_REMITENTE=FinanceUp <tu_correo@gmail.com>

# ---------------------------------------------------------------
# Login con Google: el "ID de cliente de OAuth" (tipo aplicacion web)
# que se crea en https://console.cloud.google.com > APIs y servicios
# > Credenciales. Termina en .apps.googleusercontent.com
# ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
